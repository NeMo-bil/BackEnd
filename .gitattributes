# Shell scripts must always use Unix line endings
*.sh text eol=lf

# Environment templates
.env.example text eol=lf

# Docker / Compose files
Dockerfile text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Application configuration
*.json text eol=lf

# Documentation
*.md text eol=lf

# Explicitly treat binary files as binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary