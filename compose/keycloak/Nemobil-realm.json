{
  "realm": "Nemobil",
  "enabled": true,

  "roles": {
    "realm": [
      {
        "name": "user",
        "description": "Standard application user"
      },
      {
        "name": "stellio-admin",
        "description": "Stellio administrator"
      },
      {
        "name": "stellio-creator",
        "description": "Stellio creator"
      }
    ]
  },

  "clientScopes": [
      {
        "name" : "roles",
        "description" : "OpenID Connect scope for add user roles to the access token",
        "protocol" : "openid-connect",
        "attributes" : {
          "include.in.token.scope" : "false",
          "display.on.consent.screen" : "true",
          "consent.screen.text" : "${rolesScopeConsentText}"
        },
        "protocolMappers" : [ 
            {
               "name" : "client roles",
               "protocol" : "openid-connect",
               "protocolMapper" : "oidc-usermodel-client-role-mapper",
               "consentRequired" : false,
               "config" : {
                 "user.attribute" : "foo",
                 "access.token.claim" : "true",
                 "claim.name" : "resource_access.${client_id}.roles",
                 "jsonType.label" : "String",
                 "multivalued" : "true"
                 }
            }, 
            {
               "name" : "realm roles",
               "protocol" : "openid-connect",
               "protocolMapper" : "oidc-usermodel-realm-role-mapper",
               "consentRequired" : false,
               "config" : {
                 "user.attribute" : "foo",
                 "access.token.claim" : "true",
                 "claim.name" : "realm_access.roles",
                 "jsonType.label" : "String",
                 "multivalued" : "true"
                 }
            }, 
            {
               "name" : "audience resolve",
               "protocol" : "openid-connect",
               "protocolMapper" : "oidc-audience-resolve-mapper",
               "consentRequired" : false,
               "config" : { }
            } 
      ]},
      {
        "name": "api:read",
        "protocol": "openid-connect"
      },
      {
        "name": "api:write",
        "protocol": "openid-connect"
      },
      {
        "name": "api:delete",
        "protocol": "openid-connect"
      }
  ],
    
    
  "clients": [
    {
      "clientId": "nemobil-app",
      "name": "NeMo-bil Mobile App",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "Nemobil_Client_Secret_2026!",
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,

      "redirectUris": [
        "*"
      ],

      "webOrigins": [
        "*"
      ],
    "defaultClientScopes": [
      "web-origins",
      "acr",
      "profile",
      "roles",
      "email"
      ],

    "optionalClientScopes": [
      "address",
      "phone",
      "offline_access",
      "microprofile-jwt",
      "api:read",
      "api:write",
      "api:delete"
      ] 
    }
  ],

  "users": [

    {
      "username": "stellio-admin@test.de",
      "enabled": true,       
      "firstName": "Stellio",
      "lastName": "Administrator",
      "requiredActions": [],
      "email": "stellio-admin@test.de",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "Nemobil_Stellio_Admin_2026!",
          "temporary": false
        }
      ],
      "realmRoles": [
        "stellio-admin"
      ]
